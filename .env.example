# Public Sanity read configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=gxb80y9b
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-02

# Generate a long random value and use the same secret in the Sanity webhook.
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-secret

# Server-only contact delivery configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_your_server_key
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <sender@your-verified-domain.example>

# Canonical production origin
NEXT_PUBLIC_SITE_URL=https://rebvar.xyz
SANITY_STUDIO_URL=https://studio.rebvar.xyz
