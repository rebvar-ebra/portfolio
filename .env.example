# Local Docker Compose defaults. Copy to .env and replace every value before production.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEMO_RESET_TOKEN=replace-with-a-long-random-reset-token
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT=60
# Comma-separated proxy networks whose X-Forwarded-For headers the API may trust.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
WEB_PORT=3000
API_PORT=8080

# Production target (documentation only; this project does not deploy itself):
# ALLOWED_ORIGIN=https://rebvar.xyz
